        },
        {
          "rank": 4,
          "video_id": "LHpplKlnXes",
          "seq": 10,
          "t": 285,
          "t_end": 325,
          "score": 0.610949,
          "hl": "So tier two is where we learn about these specific AI engineering skills.",
